<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>LK — Aviso</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    body{margin:0;background:#0a0a0a;color:#fff;font-family:'DM Sans',sans-serif;display:flex;align-items:center;justify-content:center;height:100vh}
    .box{text-align:center;max-width:420px;padding:40px}
    .k{font-size:8px;letter-spacing:4px;text-transform:uppercase;color:#b5b0a8;margin-bottom:20px}
    h1{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:30px;margin:0 0 16px}
    p{font-weight:300;font-size:14px;color:#b5b0a8;line-height:1.7}
    a{display:inline-block;margin-top:28px;color:#fff;border-bottom:1px solid #fff;text-decoration:none;font-size:9px;letter-spacing:3px;text-transform:uppercase;padding-bottom:3px}
  </style>
</head>
<body>
  <div class="box">
    <div class="k">Validação</div>
    <h1>Não foi possível concluir</h1>
    <p><%= msg %></p>
    <a href="/">Voltar ao painel</a>
  </div>
</body>
</html>
